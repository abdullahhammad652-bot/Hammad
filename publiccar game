import pygame
import random

# Initialize Pygame
pygame.init()

# Constants
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
CAR_WIDTH = 50
CAR_HEIGHT = 100
FPS = 60

# Colors
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
RED = (255, 0, 0)
GREEN = (0, 255, 0)

# Load car images
player_car = pygame.image.load('player_car.png')
enemy_car = pygame.image.load('enemy_car.png')

# Set up the display
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption('Car Game')

# Game loop
def game_loop():
    clock = pygame.time.Clock()
    player_x = SCREEN_WIDTH // 2
    player_y = SCREEN_HEIGHT - CAR_HEIGHT - 10
    enemy_x = random.randint(0, SCREEN_WIDTH - CAR_WIDTH)
    enemy_y = -CAR_HEIGHT
    score = 0
    running = True

    while running:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False

        keys = pygame.key.get_pressed()
        if keys[pygame.K_LEFT] and player_x > 0:
            player_x -= 5
        if keys[pygame.K_RIGHT] and player_x < SCREEN_WIDTH - CAR_WIDTH:
            player_x += 5

        enemy_y += 5
        if enemy_y > SCREEN_HEIGHT:
            enemy_y = -CAR_HEIGHT
            enemy_x = random.randint(0, SCREEN_WIDTH - CAR_WIDTH)
            score += 1

        # Collision detection
        if (player_y < enemy_y + CAR_HEIGHT and
            player_y + CAR_HEIGHT > enemy_y and
            player_x < enemy_x + CAR_WIDTH and
            player_x + CAR_WIDTH > enemy_x):
            running = False

        # Drawing
        screen.fill(WHITE)
        screen.blit(player_car, (player_x, player_y))
        screen.blit(enemy_car, (enemy_x, enemy_y))
        pygame.display.flip()
        clock.tick(FPS)

    pygame.quit()

# Start the game
game_loop()
